{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Material Return Response Schema",
  "type": "object",
  "additionalProperties": true,

  "required": [
    "id",
    "company_id",
    "project_id",
    "party_company_user_id",
    "invoice_id",
    "material_ids",
    "material_amount",
    "total_payable",
    "return_date"
  ],

  "properties": {

    "id": {"type": "string"},
    "company_id": {"type": "string"},
    "remark": {"type": "string"},
    "creator_company_user_id": {"type": "string"},
    "party_company_user_id": {"type": "string"},
    "project_id": {"type": "string"},
    "sub_category_id": {"type": "string"},
    "invoice_id": {"type": "string"},
    "material_ids": {"type": "array","items": {"type": "string"}},
    "discount": {"type": "number"},
    "gst_amount": {"type": "number"},
    "other_amount": {"type": "number"},
    "material_amount": {"type": "number"},
    "total_payable": {"type": "number"},
    "prefix": {"type": "string"},
    "sequence": {"type": "integer"},
    "return_number": {"type": "string"},
    "photos": {"type": "array","items": {"type": "string"}},
    "return_date": {"type": "string","format": "date-time"},
    "vendor_reference_number": {"type": "string"},
    "delete": {"type": "integer"},
    "created": {"type": "string","format": "date-time"},
    "updated": {"type": "string","format": "date-time"},
    "updated_by_cu_id": {"type": "string"},
    "approval_flag": {"type": "string"},
    "monkey_patch_is_editable": {"type": "integer"},
    "monkey_patch_paid_amount": {"type": "number"},
    "monkey_patch_status": {"type": "string"},
    "approval_comment": {"type": "string"},
    "approved_by": {"type": "string"},
    "due_days": {"type": "number"},
    "meta_data": {
      "type": "object",
      "properties": {
        "can_edit": {
          "type": "integer"
        },
        "can_update_approval_flag": {
          "type": "integer"
        }
      },
      "required": [
        "can_edit",
        "can_update_approval_flag"
      ]
    }
  }
}